# Xosting document root xato ravishda backend/ ga (public/ o'rniga) qaratilgan taqdirda
# himoya sifatida: faqat public/ ichidagi fayllarga ruxsat, qolganiga yo'q.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
