# === MySQL ulanish sozlamalari ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kompaniya_anticor
DB_USER=anticor_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

# === CORS: frontend joylashgan domen(lar), vergul bilan ajratib ===
# Masalan: https://au3004.github.io,https://anticor.uztelecom.uz
# Agar aniq domen bilmasangiz vaqtincha * qo'ying (unda credentials ishlatilmaydi).
ALLOWED_ORIGINS=*

# === Backend ochiq (public) manzili ===
# Yuklangan rasmlar (profil fotosi) uchun to'liq URL yasashda ishlatiladi.
# Masalan: https://api.your-domain.uz/backend/public
PUBLIC_BASE_URL=http://localhost/backend/public

# === Sessiya ===
# Harakatsizlik (idle) muddati — foydalanuvchi shuncha daqiqa davomida hech
# qanday amal bajarmasa, sessiya tugaydi va login sahifasiga qaytariladi.
# Har bir amalda bu muddat qaytadan boshidan sanaladi ("sliding"):
SESSION_IDLE_MINUTES=30
# Sessiya yaratilgandan boshlab mutlaq maksimal umr (soatlarda) — doimiy
# faol bo'lsa ham token bundan uzoqroq amal qilmaydi (standart: 7 kun):
SESSION_ABSOLUTE_TTL_HOURS=168

# === Login cheklovlari ===
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# === Test ===
TEST_PASS_THRESHOLD=80

# === Profil rasmi yuklash ===
UPLOAD_MAX_BYTES=2097152

# === HTTPS ===
# Production serverda albatta "true" qiling — login/parol kabi ma'lumotlar
# shifrlanmagan (http://) ulanish orqali hech qachon yuborilmasligi kerak.
# Mahalliy (XAMPP/localhost) test uchun "false" qoldiring.
FORCE_HTTPS=false
