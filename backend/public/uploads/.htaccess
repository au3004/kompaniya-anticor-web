# Yuklangan fayllar katalogi: PHP bajarilishini o'chiramiz (himoya chorasi),
# faqat rasm fayllarga xizmat ko'rsatiladi.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Brauzer faylni deklaratsiya qilingan Content-Type'dan boshqacha (masalan
# HTML/skript sifatida) "hidlab" ochishga urinmasin — bu statik fayllar
# to'g'ridan-to'g'ri veb-server tomonidan uzatiladi (PHP orqali emas),
# shuning uchun Response.php'dagi shu sarlavha bu yerga tarqalmaydi.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
<FilesMatch "\.(php|phtml|php\d?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
