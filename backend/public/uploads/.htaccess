# Yuklangan fayllar katalogi: PHP bajarilishini o'chiramiz (himoya chorasi),
# faqat rasm fayllarga xizmat ko'rsatiladi.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php\d?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
